DATA_DIR=/data
DATABASE_URL=sqlite:////data/app.db

SEEDVR2_CLI_PATH=/opt/seedvr2/inference_cli.py
SEEDVR2_REPO_DIR=/opt/seedvr
SEEDVR2_MODEL_DIR=/models/seedvr2
BROWSE_ROOTS=/data:/models:/external

MOCK_PIPELINE=true
RUN_IN_PROCESS_WORKER=false
PREFER_GPU=true
REQUIRE_GPU_FOR_REAL_PIPELINE=true

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
